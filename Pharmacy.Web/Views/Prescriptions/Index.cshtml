@model System.Data.DataTable

@{
    ViewData["Title"] = "الوصفات الطبية";
}

<h2>الوصفات الطبية</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<a asp-action="Create" class="btn btn-primary mb-3">+ وصفة طبية جديدة</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>الكود</th>
            <th>العميل</th>
            <th>الطبيب</th>
            <th>التاريخ</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (System.Data.DataRow row in Model.Rows)
        {
            <tr>
                <td>@row["PrescriptionID"]</td>
                <td>@row["CustomerName"]</td>
                <td>@row["DoctorName"]</td>
                <td>@row["IssueDate"]</td>
                <td>
                    <a asp-action="Details" asp-route-id="@row["PrescriptionID"]" class="btn btn-sm btn-info">عرض التفاصيل</a>
                </td>
            </tr>
        }
    </tbody>
</table>
