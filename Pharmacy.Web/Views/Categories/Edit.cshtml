@model Pharmacy.Business.clsCategory

@{
    ViewData["Title"] = "تعديل التصنيف";
}

<h2>تعديل التصنيف</h2>

<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="CategoryID" />

    <div class="form-group mb-3">
        <label asp-for="CategoryName">اسم التصنيف</label>
        <input asp-for="CategoryName" class="form-control" required />
        <span asp-validation-for="CategoryName" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">حفظ</button>
    <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
</form>
