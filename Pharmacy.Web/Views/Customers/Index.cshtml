@model System.Data.DataTable

@{
    ViewData["Title"] = "العملاء";
}

<h2>العملاء</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<a asp-action="Create" class="btn btn-primary mb-3">+ إضافة عميل جديد</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>الكود</th>
            <th>الاسم</th>
            <th>الهاتف</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (System.Data.DataRow row in Model.Rows)
        {
            <tr>
                <td>@row["CustomerID"]</td>
                <td>@row["Name"]</td>
                <td>@row["Phone"]</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@row["CustomerID"]" class="btn btn-sm btn-warning">تعديل</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <form asp-action="Delete" asp-route-id="@row["CustomerID"]" method="post" style="display:inline"
                              onsubmit="return confirm('متأكد من حذف هذا العميل؟');">
                            <button type="submit" class="btn btn-sm btn-danger">حذف</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
