@model Pharmacy.Business.clsDoctor

@{
    ViewData["Title"] = "تعديل بيانات الطبيب";
}

<h2>تعديل بيانات الطبيب</h2>

<form asp-action="Edit" asp-route-id="@Model.DoctorID" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="DoctorID" />

    <div class="form-group mb-2">
        <label asp-for="Name">اسم الطبيب</label>
        <input asp-for="Name" class="form-control" required />
    </div>

    <div class="form-group mb-2">
        <label asp-for="Specialization">التخصص</label>
        <input asp-for="Specialization" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="Phone">الهاتف</label>
        <input asp-for="Phone" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">حفظ التعديلات</button>
    <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
</form>
